// Northern Bloom v1 schema. Tables snake_case (via @@map), columns camelCase.
// Money is always integer cents.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider             = "postgresql"
  url                  = env("DATABASE_URL")
  shadowDatabaseUrl    = env("SHADOW_DATABASE_URL")
}

// Role model mirrors NYX SYS: customers book, staff/counter are salon-side
// (portal lives in the desktop app), owner/developer manage everything.
enum Role {
  CUSTOMER
  STAFF
  COUNTER
  OWNER
  ADMIN
  DEVELOPER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OrderStatus {
  PLACED
  CONFIRMED
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum CouponKind {
  PERCENT
  FIXED
}

enum PaymentMethod {
  CASH
  UPI
  STRIPE
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

// Used for staff (their own gender, for the male/female stylist filter) and
// for services (forGender: which clientele a service is for; null = everyone).
enum Gender {
  MALE
  FEMALE
}

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  brand     Json     @default("{}")
  features  Json     @default("{}")
  settings  Json     @default("{}")
  createdAt DateTime @default(now())

  users        User[]
  services     Service[]
  staffMembers Staff[]
  categories   ProductCategory[]
  products     Product[]
  coupons      Coupon[]
  orders       Order[]
  appointments Appointment[]
  pushMessages PushMessage[]

  @@map("tenants")
}

model User {
  id             String   @id @default(uuid())
  tenantId       String
  role           Role     @default(CUSTOMER)
  name           String
  email          String
  phone          String?
  passwordHash   String
  marketingOptIn Boolean  @default(true)
  createdAt      DateTime @default(now())

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  devices       Device[]
  addresses     Address[]
  appointments  Appointment[]      @relation("CustomerAppointments")
  sentPushes    PushMessage[]      @relation("PushMessageAuthor")
  orders        Order[]
  notifications Notification[]
  redemptions   CouponRedemption[]

  @@unique([tenantId, email])
  @@map("users")
}

model Device {
  id           String   @id @default(uuid())
  userId       String
  fcmToken     String   @unique
  platform     String   @default("android")
  lastActiveAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("devices")
}

model Address {
  id         String  @id @default(uuid())
  userId     String
  label      String?
  line1      String
  city       String?
  postalCode String?
  notes      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Service {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  description String?
  durationMin Int
  priceCents  Int
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
  category    String? // e.g. "Hair Cut", "Facial O3+", "Makeup" — for grouping
  forGender   Gender? // null = for everyone; MALE = gents-only; FEMALE = ladies-only

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  staffServices StaffService[]
  appointments  Appointment[]

  @@map("services")
}

model Staff {
  id      String  @id @default(uuid())
  tenantId String
  name    String
  bio     String?
  active  Boolean @default(true)
  gender      Gender?  // set in the admin panel; drives the male/female stylist filter
  photoUrl    String?
  specialties String[] @default([]) // e.g. ["Hair", "Bridal"] — what they're known for

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  staffServices StaffService[]
  availability StaffAvailability[]
  timeOff      TimeOff[]
  appointments Appointment[]

  @@map("staff")
}

model StaffService {
  staffId    String
  serviceId  String

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@map("staff_services")
}

model StaffAvailability {
  id       String @id @default(uuid())
  staffId  String
  weekday  Int
  startMin Int
  endMin   Int

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_availability")
}

model TimeOff {
  id       String   @id @default(uuid())
  staffId  String
  startsAt DateTime
  endsAt   DateTime

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("time_off")
}

model Appointment {
  id         String            @id @default(uuid())
  tenantId   String
  customerId String
  staffId    String
  serviceId  String
  startsAt   DateTime
  endsAt     DateTime
  status     AppointmentStatus @default(CONFIRMED)
  notes      String?
  createdAt  DateTime          @default(now())

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  customer User   @relation("CustomerAppointments", fields: [customerId], references: [id])
  staff    Staff  @relation(fields: [staffId], references: [id])
  service  Service @relation(fields: [serviceId], references: [id])

  @@index([tenantId, startsAt])
  @@index([customerId])
  @@index([staffId, startsAt])
  // Overlap prevention for active bookings is a DB exclusion constraint;
  // see prisma/exclusion-constraint.sql (applied in the init migration).
  @@map("appointments")
}

model ProductCategory {
  id        String @id @default(uuid())
  tenantId  String
  name      String
  sortOrder Int    @default(0)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@map("product_categories")
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  categoryId  String?
  name        String
  description String?
  priceCents  Int
  imageUrl    String?
  stock       Int      @default(0)
  trackStock  Boolean  @default(true)
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  category         ProductCategory?  @relation(fields: [categoryId], references: [id])
  orderItems       OrderItem[]
  stockAdjustments StockAdjustment[]

  @@index([tenantId, categoryId])
  @@map("products")
}

// Audit ledger for manual stock changes: every add/remove carries a reason and
// the manager who made it. Sales decrements happen in the order txn, not here.
model StockAdjustment {
  id          String   @id @default(uuid())
  tenantId    String
  productId   String
  delta       Int // positive = restock/found, negative = removal/damage/correction
  reason      String
  createdById String?
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([productId])
  @@map("stock_adjustments")
}

model Coupon {
  id            String      @id @default(uuid())
  tenantId      String
  code          String
  kind          CouponKind
  value         Int
  minOrderCents Int         @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  maxUses       Int?
  maxPerUser    Int         @default(1)
  active        Boolean     @default(true)

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  orders      Order[]
  redemptions CouponRedemption[]

  @@unique([tenantId, code])
  @@map("coupons")
}

model CouponRedemption {
  id       String @id @default(uuid())
  couponId String
  userId   String
  orderId  String @unique

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

model Order {
  id               String          @id @default(uuid())
  tenantId         String
  customerId       String
  status           OrderStatus     @default(PLACED)
  fulfillment      FulfillmentType
  address          Json?
  subtotalCents    Int
  discountCents    Int             @default(0)
  deliveryFeeCents Int             @default(0)
  codChargeCents   Int             @default(0)
  totalCents       Int
  couponId         String?
  notes            String?
  placedAt         DateTime        @default(now())

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  customer User    @relation(fields: [customerId], references: [id])
  coupon   Coupon? @relation(fields: [couponId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([tenantId, status])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id            String @id @default(uuid())
  orderId       String
  productId     String?
  name          String
  unitPriceCents Int
  qty           Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String
  method      PaymentMethod @default(CASH)
  status      PaymentStatus @default(UNPAID)
  amountCents Int
  providerRef String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model PushMessage {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  body        String
  deeplink    String?
  createdById String?
  sentAt      DateTime?

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  createdBy User?  @relation("PushMessageAuthor", fields: [createdById], references: [id])

  @@map("push_messages")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String?
  deeplink  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}
